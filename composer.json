{
  "name": "tabling/table",
  "description": "Symfony backend table-definition primitive for provider-neutral columns, filters, actions and security.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "collectioning/collection": "dev-main || dev-master",
    "php": "^8.4",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/security-bundle": "^8.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\Tabling\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Tabling\\TablingBundle"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3"
  },
  "scripts": {
    "test": "phpunit tests",
    "phpstan": "phpstan analyse src tests --level=8",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  }
}
