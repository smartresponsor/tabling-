{
  "name": "tabling/table",
  "description": "Symfony backend table-definition primitive for provider-neutral columns, filters, actions and security.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "collectioning/collection": "dev-master",
    "php": "^8.4",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/security-bundle": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Tabling\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Tabling\\TablingBundle"
    }
  },
  "config": {
    "sort-packages": true
  }
}
