{
  "name": "tabling/table",
  "description": "Symfony backend table-definition primitive for provider-neutral columns, filters, actions and security.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.5",
    "failing/failure": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "php": "^8.4",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/security-bundle": "^8.1",
    "viewing/view": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Tabling\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Tabling\\TablingBundle"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "gating/gate": "dev-master"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ]
}
