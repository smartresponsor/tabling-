{
  "name": "tabling/table",
  "description": "Symfony backend table-definition primitive for provider-neutral columns, filters, actions and security.",
  "type": "symfony-bundle",
  "license": "PolyForm-Noncommercial-1.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.5",
    "failing/failure": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "php": "^8.4",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/security-bundle": "^8.1",
    "viewing/view": "dev-master"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Failing",
      "options": {
        "symlink": true,
        "versions": {
          "failing/failure": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\Tabling\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Tabling\\TablingBundle"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "gating/gate": "dev-master",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/panther": "^2.4"
  },
  "scripts": {
    "test": "phpunit tests",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --branch-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "validate:prod": "composer validate --strict --no-check-all composer.prod.json",
    "phpstan": "phpstan analyse -c phpstan.neon",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "quality": [
      "@test",
      "@test:coverage",
      "@phpstan",
      "@cs:check",
      "@validate:prod",
      "@gate"
    ],
    "gate": "@php vendor/bin/gating check --target=."
  }
}
